node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# Runtime Scans & Generated Evaluation Outputs
# ------------------------------------------------------------------------------
# Generated scan outputs from pipeline runs (keep repos clean of scan artifacts)
scans/
**/ecdat_output/
!testbeds/sample_crypto_app/ecdat_output/
!testbeds/sample_crypto_app/ecdat_output/**
!testbeds/sample_crypto_app/ecdat_output/*.pem
!testbeds/sample_crypto_app/ecdat_output/*.hex
testbeds/benchmarks/
testbeds/*_scan_output/
*.hex
!testbeds/sample_crypto_app/ecdat_output/*.hex
proofs/
test_probe.txt

# ------------------------------------------------------------------------------
# Binaries & Compiled Executables
# ------------------------------------------------------------------------------
# Note: cbomkit-theia is ~40MB. If you prefer to distribute it via GitHub Releases
# or download script instead of bloating Git history, keep this uncommented:
bin/cbomkit-theia
*.exe
*.dll
*.dylib

# ------------------------------------------------------------------------------
