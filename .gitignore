# ------------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.bak
*.tmp
.lo_profile/

